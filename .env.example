APP_NAME=DataOps AI
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://dataops:dataops@postgres:5432/dataops
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=720
FRONTEND_ORIGIN=http://localhost:3100
WEB_HOST_PORT=3100
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_MAX_TOOL_CALLS=8
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# Local development only. When true, the web build signs in automatically with
# the seeded credentials above. Never enable this for a shared or deployed
# environment: it removes the interactive authentication step.
NEXT_PUBLIC_DEV_AUTO_LOGIN=false
NEXT_PUBLIC_DEV_EMAIL=admin@example.com
NEXT_PUBLIC_DEV_PASSWORD=change-me-now
